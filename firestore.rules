rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isHouseholdMember(householdId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    function profileMergeSafe() {
      return !request.resource.data.keys().hasAny(['pro'])
        || request.resource.data.pro == resource.data.pro;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['pro']);

      allow update: if isOwner(uid)
        && profileMergeSafe()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoUrl', 'householdId', 'createdAt', 'updatedAt']);

      match /money/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /household_invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    match /households/{householdId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        || resource.data.memberCount < 2
      );

      allow create: if request.auth != null
        && request.resource.data.memberCount == 1
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberIds', 'memberCount']))
        || (
          resource.data.memberCount < 2
          && !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberCount == resource.data.memberCount + 1
        )
        || (
          request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
        )
      );

      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      match /entries/{entryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isHouseholdMember(householdId)
          && resource.data.uid == request.auth.uid;
      }
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /admin_logs/{logId} {
      allow read, write: if false;
    }
  }
}
